# ---- required
BOT_TOKEN=123456:ABC...                 # from @BotFather
STATE_KEY=change-me-to-a-long-random-passphrase   # >=16 chars; encrypts every stored Cloudflare credential + the checkpoint

# The Cloudflare API token is NOT configured here — every user connects their own
# token (or Global API Key) inside Telegram via /start or /token (stored encrypted).

# ---- hosting on GitHub Actions (set as secrets of the HOST repo; the workflow passes them through)
HOST_PAT=ghp_...                        # PAT of the repo that HOSTS the bot (contents + actions write). Used ONLY to push
                                        # the encrypted checkpoint and restart the workflow. Alias GH_PAT. Falls back to GITHUB_TOKEN.
TAVILY_API_KEY=tvly-...                 # optional: enables CLOUDFLARE_AI web_search / web_extract (alias: TAVILY)

# ---- optional
OWNER_IDS=123456789                     # comma-separated Telegram user ids; empty = first /start becomes owner
MAX_RUN_MINUTES=330                     # hand off to a new workflow run before the 6h job limit
CHECKPOINT_INTERVAL=120                 # seconds between encrypted state pushes (only when changed)
AI_MAX_ITERATIONS=60
LOG_LEVEL=INFO
DATA_DIR=data
TELEGRAM_API_URL=                       # point at a local Bot API server (tests / self-hosted); empty = official
